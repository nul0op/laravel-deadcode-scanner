{
    "name": "zalanihir/deadcode-scanner",
    "description": "Automatic dead code and route scanner for Laravel",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "ZalaNihir\\DeadcodeScanner\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZalaNihir\\DeadcodeScanner\\DeadCodeScannerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev"
}
